        ],
        "type": "object",
        "properties": {
          "nome": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "idade": {
            "maximum": 150,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "TipoTransacao": {
        "enum": [
          1,
          2
        ],
        "type": "integer",
        "format": "int32"
      },
      "TransacaoDto": {
        "required": [
          "categoriaId",
          "descricao",
          "pessoaId",
          "tipo"
        ],
        "type": "object",
        "properties": {
          "descricao": {
            "maxLength": 400,
            "minLength": 1,
            "type": "string"
          },
          "valor": {
            "minimum": 0,01,
            "type": "number",
            "format": "double"
          },
          "tipo": {
            "$ref": "#/components/schemas/TipoTransacao"
          },
          "categoriaId": {
            "type": "integer",
            "format": "int32"
          },
