@model TesteTecnico.APP.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1 fw-bold">Dashboard</h1>
        <p class="text-muted mb-0">Visão geral do controle de gastos pessoais.</p>
    </div>
    <div>
        <a asp-controller="Transacoes" asp-action="Create" class="btn btn-primary">
            Nova Transação
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-2">
        <div class="card shadow-sm h-100 border-0">
            <div class="card-body">
                <div class="text-muted small mb-2">Pessoas</div>
                <div class="fs-2 fw-bold">@Model.TotalPessoas</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-2">
        <div class="card shadow-sm h-100 border-0">
            <div class="card-body">
                <div class="text-muted small mb-2">Categorias</div>
                <div class="fs-2 fw-bold">@Model.TotalCategorias</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-2">
        <div class="card shadow-sm h-100 border-0">
            <div class="card-body">
                <div class="text-muted small mb-2">Transações</div>
                <div class="fs-2 fw-bold">@Model.TotalTransacoes</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-2">
        <div class="card shadow-sm h-100 border-0 border-start border-4 border-success">
            <div class="card-body">
                <div class="text-muted small mb-2">Receitas</div>
                <div class="fs-5 fw-bold text-success">@Model.TotalReceitas.ToString("C")</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-2">
        <div class="card shadow-sm h-100 border-0 border-start border-4 border-danger">
            <div class="card-body">
                <div class="text-muted small mb-2">Despesas</div>
                <div class="fs-5 fw-bold text-danger">@Model.TotalDespesas.ToString("C")</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-2">
        <div class="card shadow-sm h-100 border-0 border-start border-4 border-primary">
            <div class="card-body">
                <div class="text-muted small mb-2">Saldo Atual</div>
                <div class="fs-5 fw-bold @(Model.SaldoLiquido >= 0 ? "text-primary" : "text-danger")">
                    @Model.SaldoLiquido.ToString("C")
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white border-0 pt-4 pb-0">
                <h5 class="fw-bold mb-1">Resumo por pessoa</h5>
                <p class="text-muted mb-0 small">Consolidado de receitas, despesas e saldo por pessoa.</p>
            </div>

            <div class="card-body table-responsive">
                <table class="table align-middle table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Pessoa</th>
                            <th>Receitas</th>
                            <th>Despesas</th>
                            <th>Saldo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.PessoasResumo != null && Model.PessoasResumo.Any())
                        {
                            @foreach (var item in Model.PessoasResumo)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.NomePessoa</td>
                                    <td class="text-success">@item.TotalReceitas.ToString("C")</td>
                                    <td class="text-danger">@item.TotalDespesas.ToString("C")</td>
                                    <td class="fw-bold @(item.Saldo >= 0 ? "text-primary" : "text-danger")">
                                        @item.Saldo.ToString("C")
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    Nenhum dado encontrado para exibir no resumo.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white border-0 pt-4 pb-0">
                <h5 class="fw-bold mb-1">Acesso rápido</h5>
                <p class="text-muted mb-0 small">Cadastros e consultas principais.</p>
            </div>

            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-controller="Pessoas" asp-action="Index" class="btn btn-outline-dark">Ver Pessoas</a>
                    <a asp-controller="Categorias" asp-action="Index" class="btn btn-outline-dark">Ver Categorias</a>
                    <a asp-controller="Transacoes" asp-action="Index" class="btn btn-outline-dark">Ver Transações</a>
                    <a asp-controller="Relatorios" asp-action="Index" class="btn btn-outline-dark">Ver Relatórios</a>
                    <a asp-controller="Transacoes" asp-action="Create" class="btn btn-primary">Cadastrar Transação</a>
                </div>
            </div>
        </div>
    </div>
</div>