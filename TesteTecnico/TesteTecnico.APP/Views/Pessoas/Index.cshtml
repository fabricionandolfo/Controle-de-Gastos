@model List<TesteTecnico.APP.Models.PessoaViewModel>
@{
    ViewData["Title"] = "Pessoas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Pessoas</h1>
    <a asp-action="Create" class="btn btn-primary">Nova Pessoa</a>
</div>

<div class="card shadow-sm">
    <div class="card-body table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nome</th>
                    <th>Idade</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pessoa in Model)
                {
                    <tr>
                        <td>@pessoa.Id</td>
                        <td>@pessoa.Nome</td>
                        <td>@pessoa.Idade</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@pessoa.Id" class="btn btn-warning btn-sm">Editar</a>
                            <form asp-action="Delete" asp-route-id="@pessoa.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Deseja excluir esta pessoa?')">Excluir</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>